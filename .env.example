GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Model selection for all agents (haiku, sonnet, or opus)
# Controls which Claude model is used by the lead agent and all subagents
CLAUDE_MODEL=haiku

# Authentication via Application Default Credentials (ADC):
# Run: gcloud auth login --update-adc
# This eliminates the need for GOOGLE_APPLICATION_CREDENTIALS file
